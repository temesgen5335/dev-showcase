# Multi-provider LLM keys for the "Ask my portfolio" chatbot.
# Priority at runtime: GROQ -> OPENAI -> GEMINI -> ANTHROPIC.
# Set at least one. The first key found wins unless LLM_PROVIDER is set.

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override. Values: groq | openai | gemini | anthropic
LLM_PROVIDER=

# Optional model overrides (defaults are sensible)
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-sonnet-4-6
