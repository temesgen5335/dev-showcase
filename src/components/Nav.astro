---
import { site, nav } from "@/data/site";
const pathname = Astro.url.pathname;
---
<header
  style="position: sticky; top: 0; z-index: 30; backdrop-filter: blur(10px); background: rgba(10,10,10,0.7); border-bottom: 1px solid var(--color-border);"
>
  <div
    class="container-x"
    style="display: flex; align-items: center; justify-content: space-between; padding-block: 0.9rem;"
  >
    <a href="/" class="mono" style="font-size: 0.95rem; color: var(--color-text-strong);">
      {site.shortName}
    </a>
    <nav style="display: flex; gap: 1.1rem;" class="mono">
      {nav.map((item) => {
        const active = pathname === item.href || pathname.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            style={`font-size: 0.82rem; color: ${active ? "var(--color-text-strong)" : "var(--color-muted)"};`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
