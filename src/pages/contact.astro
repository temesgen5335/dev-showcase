---
import Base from "@/layouts/Base.astro";
import { site, socials } from "@/data/site";
---
<Base title="Contact" description={`Get in touch with ${site.name}.`}>
  <div class="contact-page">
  <header style="margin-bottom: 2rem;">
    <div class="mono" style="color: var(--color-muted); font-size: 0.78rem; margin-bottom: 0.6rem;">// contact</div>
    <h1 style="margin: 0 0 0.8rem; font-size: clamp(1.8rem, 4vw, 2.6rem);">Let's talk.</h1>
    <p style="margin: 0; max-width: 42rem; color: var(--color-text); line-height: 1.6;">
      I'm open to new opportunities that involve building smart, scalable systems and solving
      meaningful problems. Drop a line — I'll do my best to respond within 24 hours.
    </p>
  </header>

  <div style="display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);" class="contact-grid">
    <form
      action={`https://formspree.io/f/${site.formspreeId}`}
      method="POST"
      class="card"
      style="padding: 1.4rem; display: flex; flex-direction: column; gap: 0.8rem;"
    >
      <label class="mono" style="display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.78rem; color: var(--color-muted);">
        your email
        <input
          required
          name="email"
          type="email"
          style="padding: 0.55rem 0.7rem; border-radius: 0.35rem; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text); font-size: 0.9rem;"
        />
      </label>
      <label class="mono" style="display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.78rem; color: var(--color-muted);">
        subject
        <input
          required
          name="subject"
          type="text"
          style="padding: 0.55rem 0.7rem; border-radius: 0.35rem; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text); font-size: 0.9rem;"
        />
      </label>
      <label class="mono" style="display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.78rem; color: var(--color-muted);">
        message
        <textarea
          required
          name="message"
          rows="6"
          style="padding: 0.55rem 0.7rem; border-radius: 0.35rem; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text); font-size: 0.9rem; font-family: inherit; resize: vertical;"
        />
      </label>
      <button class="btn btn-primary" type="submit" style="align-self: flex-start;">send message →</button>
    </form>

    <aside style="display: flex; flex-direction: column; gap: 1rem;">
      <div class="card" style="padding: 1.2rem 1.4rem;">
        <div class="mono" style="font-size: 0.78rem; color: var(--color-muted); margin-bottom: 0.4rem;">// direct</div>
        <a href={`mailto:${site.email}`} style="color: var(--color-text-strong); font-size: 0.92rem;">{site.email}</a>
        <div style="margin-top: 0.25rem; color: var(--color-muted); font-size: 0.82rem;">{site.phone}</div>
      </div>
      <div class="card" style="padding: 1.2rem 1.4rem;">
        <div class="mono" style="font-size: 0.78rem; color: var(--color-muted); margin-bottom: 0.5rem;">// elsewhere</div>
        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="mono" style="font-size: 0.85rem;">
              {s.label} →
            </a>
          ))}
        </div>
      </div>
      <div class="card" style="padding: 1.2rem 1.4rem;">
        <div class="mono" style="font-size: 0.78rem; color: var(--color-muted); margin-bottom: 0.4rem;">// availability</div>
        <div style="color: var(--color-text); font-size: 0.9rem; line-height: 1.55;">
          Open to senior AI engineering roles and freelance engagements. Remote-friendly, based in Addis Ababa.
        </div>
      </div>
    </aside>
  </div>
  </div>

  <style>
    /* Cyber-punk / space-traveler accent: scoped to /contact only. */
    .contact-page a {
      transition: color 150ms ease, text-shadow 200ms ease;
    }
    .contact-page a:hover {
      color: #e8c365;
      text-shadow:
        0 0 1px rgba(212, 165, 72, 0.55),
        0 0 12px rgba(212, 165, 72, 0.32);
    }
    .contact-page input,
    .contact-page textarea {
      transition: border-color 150ms ease, box-shadow 200ms ease;
    }
    .contact-page input:focus,
    .contact-page textarea:focus {
      outline: none;
      border-color: rgba(212, 165, 72, 0.7);
      box-shadow: 0 0 0 3px rgba(212, 165, 72, 0.18);
    }
    .contact-page .btn-primary:hover {
      background: #e8c365;
      border-color: #e8c365;
      color: #000;
    }
    @media (prefers-reduced-motion: reduce) {
      .contact-page a,
      .contact-page input,
      .contact-page textarea {
        transition: none;
      }
    }
    @media (max-width: 42rem) {
      .contact-grid {
        grid-template-columns: minmax(0, 1fr) !important;
      }
    }
  </style>
</Base>
