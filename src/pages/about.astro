---
import Base from "@/layouts/Base.astro";
import SkillsGrid from "@/components/SkillsGrid.astro";
import ContactCTA from "@/components/ContactCTA.astro";
import { certifications, education } from "@/data/skills";
import { site } from "@/data/site";
---
<Base title="About" description={`About ${site.name}.`}>
  <header style="margin-bottom: 2.5rem; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: start;">
    <div>
      <div class="mono" style="color: var(--color-muted); font-size: 0.78rem; margin-bottom: 0.6rem;">// about</div>
      <h1 style="margin: 0 0 1rem; font-size: clamp(1.8rem, 4vw, 2.6rem);">
        Hi, I'm Temesgen.
      </h1>
      <p style="margin: 0 0 1rem; color: var(--color-text); line-height: 1.7; max-width: 42rem;">
        I'm a full-stack developer and AI engineer with a passion for creating smart, scalable,
        and accessible digital solutions. My work blends advanced machine learning techniques with
        clean, modern frontend experiences. I enjoy building tools that not only solve problems
        but also delight users.
      </p>
      <p style="margin: 0; color: var(--color-text); line-height: 1.7; max-width: 42rem;">
        I build agentic AI systems, RAG pipelines, and production-ready AI applications. I'm currently
        Founding AI Engineer at <strong style="color: var(--color-text-strong);">Chronos</strong> in
        San Francisco, and before that I led GenAI work at 10 Academy, built a Sales Force Automation
        System at Bluespark, and shipped platforms for Ethiopia's Ministry of Innovation and Technology.
      </p>
    </div>
    <img
      src={site.avatarPath}
      alt="Temesgen Gebreabzgi"
      width="180"
      height="180"
      style="width: 10rem; height: 10rem; border-radius: 0.5rem; object-fit: cover; border: 1px solid var(--color-border);"
    />
  </header>

  <section style="margin-block: 2rem;">
    <h2 style="font-size: 0.95rem; color: var(--color-muted); margin: 0 0 1.1rem;">// skills</h2>
    <SkillsGrid />
  </section>

  <section style="margin-block: 2.5rem;">
    <h2 style="font-size: 0.95rem; color: var(--color-muted); margin: 0 0 1.1rem;">// education</h2>
    <div style="display: grid; gap: 0.8rem;">
      {education.map((e) => (
        <div class="card" style="padding: 1rem 1.2rem;">
          <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
            <div>
              <div class="mono" style="color: var(--color-text-strong); font-size: 0.92rem;">{e.degree}</div>
              <div style="color: var(--color-muted); font-size: 0.82rem; margin-top: 0.2rem;">{e.school} · {e.location}</div>
            </div>
            <div class="mono" style="color: var(--color-muted); font-size: 0.78rem;">{e.end}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section style="margin-block: 2.5rem;">
    <h2 style="font-size: 0.95rem; color: var(--color-muted); margin: 0 0 1.1rem;">// certifications</h2>
    <div style="display: grid; gap: 0.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));">
      {certifications.map((c) => (
        <a class="card" href={c.href} target="_blank" rel="noopener noreferrer" style="padding: 0.8rem 1rem; display: block;">
          <div class="mono" style="font-size: 0.88rem; color: var(--color-text-strong);">{c.name}</div>
          <div style="color: var(--color-muted); font-size: 0.78rem;">{c.issuer}</div>
        </a>
      ))}
    </div>
  </section>

  <ContactCTA />
</Base>
