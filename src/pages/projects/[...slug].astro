---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <a href="/projects" class="mono" style="font-size: 0.78rem; color: var(--color-muted);">← all projects</a>
  <header style="margin: 1.25rem 0 2rem;">
    <h1 style="margin: 0 0 0.5rem; font-size: clamp(1.7rem, 4vw, 2.4rem);">{d.title}</h1>
    <p style="margin: 0; color: var(--color-text); max-width: 44rem; line-height: 1.55;">{d.summary}</p>
    <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem;">
      {d.stack.map((s) => <span class="tag">{s}</span>)}
    </div>
    <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
      {d.liveUrl && <a class="btn btn-primary" href={d.liveUrl} target="_blank" rel="noopener noreferrer">live demo ↗</a>}
      {d.githubUrl && <a class="btn" href={d.githubUrl} target="_blank" rel="noopener noreferrer">github ↗</a>}
    </div>
  </header>

  {d.impact.length > 0 && (
    <section class="card" style="padding: 1.2rem 1.4rem; margin-bottom: 2rem;">
      <h2 style="margin: 0 0 0.6rem; font-size: 0.85rem; color: var(--color-muted);">// impact</h2>
      <ul style="margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.3rem; color: var(--color-text); font-size: 0.92rem; line-height: 1.55;">
        {d.impact.map((i) => <li>{i}</li>)}
      </ul>
    </section>
  )}

  <article style="max-width: 44rem; color: var(--color-text); line-height: 1.7;">
    <Content />
  </article>

  {d.gallery.length > 0 && (
    <section style="margin-top: 2.5rem;">
      <h2 style="font-size: 0.85rem; color: var(--color-muted); margin: 0 0 1rem;">// gallery</h2>
      <div style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));">
        {d.gallery.map((src) => (
          <div style="border: 1px solid var(--color-border); border-radius: 0.4rem; overflow: hidden; background: var(--color-bg);">
            <img src={src} alt={d.title} style="width: 100%; height: auto; display: block;" loading="lazy" />
          </div>
        ))}
      </div>
    </section>
  )}
</Base>
